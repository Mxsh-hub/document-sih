# Copy to .env and replace every value before running outside a test environment.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://astra:astra@localhost:55432/astra
JWT_SECRET=replace-with-at-least-32-random-characters
DOWNLOAD_SIGNING_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173
STORAGE_BACKEND=local
PROCESS_DOCUMENTS_INLINE=true
MAX_PDF_PAGES=200
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_SECONDS=900
# S3/MinIO options are required when STORAGE_BACKEND=s3.
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=astra-documents
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# ZKP (pinned sound faculty threshold circuit)
ZKP_ENABLED=true
ZKP_CHALLENGE_TTL_SECONDS=600
FACULTY_THRESHOLD_SCALED=700
ZKP_ALLOW_LEGACY_CIRCUIT=false
# SNARKJS_BIN=/absolute/path/to/snarkjs

# Blockchain anchoring (disabled by default; advisory only)
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_PROOF_ANCHORING_ENABLED=false
BLOCKCHAIN_NETWORK=hardhat
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=
ASTRA_VERIFY_ANCHOR_ADDRESS=
FACULTY_THRESHOLD_VERIFIER_ADDRESS=

# Legacy consumer-wallet API surface (upload/digilocker/issuer/verify/verifier).
# Off by default: those routes are unauthenticated demo endpoints from the original
# credential wallet and are not part of the AICTE compliance workflow.
# Set to true only for a local demo of the legacy Issuer Portal; it also needs a
# running Hardhat node (see docs/DEMO_RUNBOOK.md, "legacy issuer portal").
LEGACY_API_ENABLED=false
